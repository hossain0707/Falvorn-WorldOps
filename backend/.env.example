APP_ENV=development
DATABASE_URL=sqlite:///./worldops.db
API_KEY=
# Optional separate key for dashboards that must never mutate state.
READ_ONLY_API_KEY=
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_AGENTS_PER_WORLD=50
MAX_MODEL_CALLS_PER_WORLD=10000
# Optional model-backed agents. Keep tokens and model names on a server-side allowlist.
LLM_API_KEY=
# Optional separate key for dashboards that must never mutate state.
READ_ONLY_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_ALLOWED_MODELS=gpt-4.1-mini,gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
# Optional approved-only outbound business integration.
WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=
POLLING_INTERVAL_SECONDS=3
